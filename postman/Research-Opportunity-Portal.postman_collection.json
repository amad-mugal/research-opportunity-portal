{
  "info": {
    "_postman_id": "6f9e78e8-50b0-4e93-9ab8-89c67c06e201",
    "name": "Research Opportunity Portal - Required API Tests",
    "description": "Run requests in order. Creates three database records, reads and updates them, closes one, deletes one, checks the deleted record returns 404, and verifies invalid input returns 400.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{"key":"baseUrl","value":"http://127.0.0.1:5000"},{"key":"opportunityId","value":""},{"key":"deleteId","value":""}],
  "item": [
    {"name":"1 - Create opportunity A (201)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"title\": \"Student project - Crop leaf health\",\n  \"description\": \"Build a model to identify common crop leaf diseases from images.\",\n  \"research_area\": \"Computer Vision\",\n  \"faculty_name\": \"Dr. Sara Khan\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, image processing\",\n  \"positions\": 2,\n  \"deadline\": \"2027-03-31\",\n  \"status\": \"Open\"\n}"},"url":{"raw":"{{baseUrl}}/api/opportunities","host":["{{baseUrl}}"],"path":["api","opportunities"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Created with 201', () => pm.response.to.have.status(201));","const body = pm.response.json();","pm.test('Response includes generated id', () => pm.expect(body.id).to.be.a('number'));","pm.collectionVariables.set('opportunityId', body.id);","pm.collectionVariables.set('deleteId', body.id);"]}}]},
    {"name":"2 - Create opportunity B (201)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"title\": \"Student project - Urdu speech tools\",\n  \"description\": \"Explore speech recognition for local language learning materials.\",\n  \"research_area\": \"Natural Language Processing\",\n  \"faculty_name\": \"Dr. Hamza Ali\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, NLP\",\n  \"positions\": 1,\n  \"deadline\": \"2027-04-15\",\n  \"status\": \"Open\"\n}"},"url":{"raw":"{{baseUrl}}/api/opportunities","host":["{{baseUrl}}"],"path":["api","opportunities"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Created with 201', () => pm.response.to.have.status(201));"]}}]},
    {"name":"3 - Create opportunity C (201)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"title\": \"Student project - Secure campus IoT\",\n  \"description\": \"Review security risks in low-cost environmental sensors.\",\n  \"research_area\": \"Cybersecurity\",\n  \"faculty_name\": \"Dr. Noor Ahmed\",\n  \"department\": \"Electrical Engineering\",\n  \"required_skills\": \"Networking, Linux\",\n  \"positions\": 3,\n  \"deadline\": \"2027-05-01\",\n  \"status\": \"Open\"\n}"},"url":{"raw":"{{baseUrl}}/api/opportunities","host":["{{baseUrl}}"],"path":["api","opportunities"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Created with 201', () => pm.response.to.have.status(201));"]}}]},
    {"name":"4 - Retrieve all opportunities (200)","request":{"method":"GET","url":{"raw":"{{baseUrl}}/api/opportunities","host":["{{baseUrl}}"],"path":["api","opportunities"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('OK and returns a list', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });","pm.test('At least three opportunities exist', () => pm.expect(pm.response.json().length).to.be.at.least(3));"]}}]},
    {"name":"5 - Retrieve one opportunity (200)","request":{"method":"GET","url":{"raw":"{{baseUrl}}/api/opportunities/{{opportunityId}}","host":["{{baseUrl}}"],"path":["api","opportunities","{{opportunityId}}"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Found opportunity details', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('opportunityId'))); });"]}}]},
    {"name":"6 - Update title and skills (200)","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"title\": \"Updated - Crop leaf health research\",\n  \"required_skills\": \"Python, computer vision, data labelling\",\n  \"positions\": 3\n}"},"url":{"raw":"{{baseUrl}}/api/opportunities/{{opportunityId}}","host":["{{baseUrl}}"],"path":["api","opportunities","{{opportunityId}}"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Update saved', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().title).to.include('Updated'); });"]}}]},
    {"name":"7 - Change status to Closed (200)","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"status\": \"Closed\"\n}"},"url":{"raw":"{{baseUrl}}/api/opportunities/{{opportunityId}}","host":["{{baseUrl}}"],"path":["api","opportunities","{{opportunityId}}"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is now Closed', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('Closed'); });"]}}]},
    {"name":"8 - Delete opportunity (200)","request":{"method":"DELETE","url":{"raw":"{{baseUrl}}/api/opportunities/{{deleteId}}","host":["{{baseUrl}}"],"path":["api","opportunities","{{deleteId}}"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Delete succeeds', () => pm.response.to.have.status(200));"]}}]},
    {"name":"9 - Retrieve deleted opportunity (404)","request":{"method":"GET","url":{"raw":"{{baseUrl}}/api/opportunities/{{deleteId}}","host":["{{baseUrl}}"],"path":["api","opportunities","{{deleteId}}"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Deleted record returns 404', () => pm.response.to.have.status(404));"]}}]},
    {"name":"10 - Invalid request missing fields (400)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"title\": \"Incomplete opportunity\",\n  \"status\": \"Maybe\"\n}"},"url":{"raw":"{{baseUrl}}/api/opportunities","host":["{{baseUrl}}"],"path":["api","opportunities"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Invalid data returns 400 with explanation', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error).to.be.a('string'); });"]}}]}
  ]
}